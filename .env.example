# ============================================
# SPAN BUSINESS - Sistema de Gestión Multi-Negocio
# Variables de Entorno
# ============================================
# Copia este archivo a .env.local (desarrollo) y configura las mismas
# variables en Render (Environment) para producción.
# Esta lista refleja exactamente lo que el código lee vía process.env —
# no agregues variables que no vayas a usar.

# --- Supabase (OBLIGATORIAS) ---
# Project Settings > API en tu proyecto de supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui
# Clave con privilegios de administrador (bypassa RLS). NUNCA exponer al cliente
# ni commitear. La usan las rutas /api/* que necesitan acceso admin.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# --- Autenticación (OBLIGATORIA en producción) ---
# Secreto para firmar los JWT de sesión. Si no se define, el código usa un
# fallback inseguro y cualquiera podría forjar una sesión válida — definilo
# siempre en producción. Generalo con: openssl rand -hex 32
JWT_SECRET=genera-un-secreto-largo-y-aleatorio
# Duración del token de sesión (formato admitido por la librería jose)
JWT_EXPIRES_IN=7d

# --- URL de la aplicación (OBLIGATORIA) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Envío de correo con Resend (opcional, recomendado en producción) ---
# Sin esta key, el sistema sigue funcionando pero no se envían correos
# (recibos, bienvenida, notificaciones).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=noreply@tudominio.com

# --- Purga automática de logs de auditoría (retención) ---
# Token compartido con el workflow de GitHub Actions que llama a
# /api/cron/purge-auditoria y /api/keep-alive. Generalo con: openssl rand -hex 32
CRON_SECRET=genera-un-secreto-largo-y-aleatorio
# Días que se conservan los logs de logs_auditoria / logs_actividad antes
# de purgarse automáticamente (ver .github/workflows/purge-auditoria.yml)
AUDITORIA_RETENCION_DIAS=365
