# ============================================
# BEAUTYPRO SALON MANAGEMENT SYSTEM
# Variables de Entorno para Producción
# ============================================

# Configuración de Supabase (Reemplaza con tus credenciales reales)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-key-anon-aqui

# Configuración de la Aplicación
NEXT_PUBLIC_APP_URL=https://tu-dominio.vercel.app

# Configuración de Correo (Opcional - para envío de recibos)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@beautypro.com
EMAIL_FROM_NAME=BeautyPro Salon

# Configuración de Autenticación (Si usas NextAuth)
NEXTAUTH_SECRET=tu-secreto-super-seguro-de-32-caracteres
NEXTAUTH_URL=https://tu-dominio.vercel.app

# Configuración de Stripe (Para pagos - Opcional)
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# Configuración de Analytics (Opcional)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=GA-XXXXXXXXXXXXXXX
VERCEL_ANALYTICS_ID=xxxxxxxxxxxxxxxxxxxxxxx

# Configuración de Desarrollo (Solo para local)
# NEXT_PUBLIC_DEV_MODE=true

# Configuración de Base de Datos Adicional (Si usas otras BD)
# DATABASE_URL=postgresql://usuario:password@localhost:5432/beautypro

# Configuración de Cache (Opcional)
# REDIS_URL=redis://localhost:6379

# Configuración de Storage (Para archivos)
# NEXT_PUBLIC_STORAGE_URL=https://tu-bucket.s3.amazonaws.com
# AWS_ACCESS_KEY_ID=tu-access-key
# AWS_SECRET_ACCESS_KEY=tu-secret-key
# AWS_REGION=us-east-1

# Configuración de API Keys (Si usas APIs externas)
# GOOGLE_CLIENT_ID=tu-google-client-id
# GOOGLE_CLIENT_SECRET=tu-google-client-secret
# FACEBOOK_APP_ID=tu-facebook-app-id
# FACEBOOK_APP_SECRET=tu-facebook-app-secret

# Configuración de Webhooks (Opcional)
# WEBHOOK_SECRET=tu-webhook-secreto

# Configuración de Límites (Opcional)
# MAX_UPLOAD_SIZE=10485760  # 10MB
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW=900000  # 15 minutos

# Configuración de Monitoreo (Opcional)
# SENTRY_DSN=https://tu-sentry-dsn
# LOG_LEVEL=info

# Configuración de Feature Flags (Opcional)
# NEXT_PUBLIC_ENABLE_ANALYTICS=true
# NEXT_PUBLIC_ENABLE_CHAT_SUPPORT=true
# NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true