'use client';

import { useState, useEffect } from 'react';
import { createClient } from '@/lib/supabase/client';
import { useJWTAuth } from '@/hooks/use-jwt-auth';
import { useRouter, useSearchParams } from 'next/navigation';
import { MainLayout } from '@/components/layout/main-layout';
import { Card, CardContent, CardHeader } from '@/components/ui/card';
import { Button } from '@/components/ui/button';
import {
  CurrencyDollarIcon,
  CalendarIcon,
  DocumentTextIcon,
  CheckCircleIcon,
  ClockIcon,
  ExclamationTriangleIcon,
  ArrowUpTrayIcon,
  XMarkIcon,
  XCircleIcon,
  EyeIcon,
  CheckCircleIcon as CheckCircleIconSolid
} from '@heroicons/react/24/outline';

// Componentes temporales para Dialog
const Dialog = ({ open, onOpenChange, children }: {
  open: boolean;
  onOpenChange: (open: boolean) => void;
  children: React.ReactNode;
}) => {
  if (!open) return null;
  
  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center">
      <div className="fixed inset-0 bg-black bg-opacity-50" onClick={() => onOpenChange(false)} />
      <div className="relative bg-white rounded-lg shadow-xl max-w-2xl w-full mx-4 max-h-screen overflow-y-auto">
        {children}
      </div>
    </div>
  );
};

const DialogContent = ({ children, className }: {
  children: React.ReactNode;
  className?: string;
}) => {
  return <div className={className}>{children}</div>;
};

const DialogHeader = ({ children }: {
  children: React.ReactNode;
}) => {
  return <div className="px-6 py-4 border-b">{children}</div>;
};

const DialogTitle = ({ children, className }: {
  children: React.ReactNode;
  className?: string;
}) => {
  return <h2 className={className}>{children}</h2>;
};

const DialogDescription = ({ children, className }: {
  children: React.ReactNode;
  className?: string;
}) => {
  return <p className={className}>{children}</p>;
};

const DialogFooter = ({ children }: {
  children: React.ReactNode;
}) => {
  return <div className="px-6 py-4 border-t bg-gray-50 flex justify-end gap-3">{children}</div>;
};

const Label = ({ children, className = '', htmlFor = '' }: {
  children: React.ReactNode;
  className?: string;
  htmlFor?: string;
}) => (
  <label htmlFor={htmlFor} className={`block text-sm font-medium text-gray-700 ${className}`}>
    {children}
  </label>
);

// Componente para mostrar beneficios del plan
const PlanBenefits = ({ plan }: { plan: Empresa }) => {
  const beneficios = [
    {
      key: 'tiene_inventario',
      label: 'Inventario',
      icon: '📦',
      description: 'Control de stock y productos'
    },
    {
      key: 'tiene_comisiones',
      label: 'Comisiones',
      icon: '💰',
      description: 'Cálculo de pagos a empleados'
    },
    {
      key: 'tiene_marketing',
      label: 'Marketing',
      icon: '📢',
      description: 'Envío de promociones'
    },
    {
      key: 'soporte_prioritario',
      label: 'Soporte Prioritario',
      icon: '⭐',
      description: 'Atención prioritaria 24/7'
    }
  ];

  return (
    <div className="space-y-3">
      <h4 className="text-sm font-medium text-gray-900">Lo que incluye tu plan:</h4>
      <div className="grid grid-cols-2 gap-2">
        {beneficios.map(beneficio => (
          <div
            key={beneficio.key}
            className={`flex items-center gap-2 px-3 py-2 rounded-lg text-sm ${plan[beneficio.key as keyof Empresa]
                ? 'bg-green-100 text-green-800 border border-green-200'
                : 'bg-gray-100 text-gray-500 border border-gray-200'
              }`}
          >
            <span className="text-base">{beneficio.icon}</span>
            <div>
              <div className="font-medium">{beneficio.label}</div>
              <div className="text-xs opacity-75">{beneficio.description}</div>
            </div>
            {plan[beneficio.key as keyof Empresa] ? (
              <CheckCircleIconSolid className="w-4 h-4 text-green-600" />
            ) : (
              <XCircleIcon className="w-4 h-4 text-gray-400" />
            )}
          </div>
        ))}
      </div>
    </div>
  );
};

// Componentes temporales
const CardTitle = ({ children, className = '' }: { children: React.ReactNode; className?: string }) => (
  <h3 className={`text-lg font-semibold text-gray-900 ${className}`}>{children}</h3>
);

const CardDescription = ({ children, className = '' }: { children: React.ReactNode; className?: string }) => (
  <p className={`text-sm text-gray-600 ${className}`}>{children}</p>
);

interface Empresa {
  id: string;
  nombre: string;
  plan_id: string;
  plan_nombre: string;
  plan_precio: number;
  tiene_inventario: boolean;
  tiene_comisiones: boolean;
  tiene_marketing: boolean;
  soporte_prioritario: boolean;
  estado: string;
  fecha_vencimiento?: string | null;
  actualizado_en: string;
}

interface Comprobante {
  id: string;
  nombre_archivo: string;
  url_archivo: string;
  tipo_archivo: string;
  tamano_bytes: number;
  estado: string;
  verificado: boolean;
  fecha_envio?: string | null;
  notas?: string;
}

export default function SuscripcionPage() {
  const { user, loading } = useJWTAuth();
  const router = useRouter();
  const searchParams = useSearchParams();

  // Mostrar mensaje de suscripción vencida si viene del middleware
  useEffect(() => {
    const error = searchParams.get('error');
    const message = searchParams.get('message');

    if (error === 'SUSCRIPCION_VENCIDA' && message) {
      setMessage({ type: 'error', text: message });
    }
  }, [searchParams]);

  const [empresa, setEmpresa] = useState<Empresa | null>(null);
  const [comprobantes, setComprobantes] = useState<any[]>([]);
  const [loadingComprobantes, setLoadingComprobantes] = useState(false);
  const [currentPage, setCurrentPage] = useState(1);
  const [itemsPerPage] = useState(5);
  const [filtroEstado, setFiltroEstado] = useState('todos');
  const [fechaInicio, setFechaInicio] = useState('');
  const [fechaFin, setFechaFin] = useState('');
  const [selectedComprobante, setSelectedComprobante] = useState<any>(null);
  const [showViewModal, setShowViewModal] = useState(false);
  const [showChangePlanModal, setShowChangePlanModal] = useState(false);
  const [showConfirmModal, setShowConfirmModal] = useState(false);
  const [selectedNewPlan, setSelectedNewPlan] = useState<any>(null);
  const [changingPlan, setChangingPlan] = useState(false);
  const [message, setMessage] = useState<{ type: 'success' | 'error'; text: string } | null>(null);
  const [hasPendingChange, setHasPendingChange] = useState(false);
  const [pendingRequest, setPendingRequest] = useState<any>(null);
  const [totalPages, setTotalPages] = useState(1);
  const [planesDisponibles, setPlanesDisponibles] = useState<any[]>([]);

  // ✅ Función para obtener el plan activo (registro más reciente aprobado)
  const getPlanActivo = async () => {
    if (!user?.empresa_id) return null;

    try {
      const supabase = createClient();
      
      // Buscar el registro más reciente (suscripción o comprobante) que esté aprobado
      const { data: suscripcionesAprobadas } = await (supabase
        .from('suscripciones') as any)
        .select(`
          *,
          planes (*)
        `)
        .eq('empresa_id', user.empresa_id)
        .eq('estado_pago', 'pagado')
        .order('actualizado_en', { ascending: false })
        .limit(1);

      const { data: comprobantesAprobados } = await (supabase
        .from('comprobantes') as any)
        .select(`
          *,
          empresas!inner (
            *,
            planes (*)
          )
        `)
        .eq('empresa_id', user.empresa_id)
        .eq('estado', 'aprobado')
        .order('actualizado_en', { ascending: false })
        .limit(1);

      // Comparar fechas y tomar el más reciente
      let registroMasReciente: any = null;
      
      if (suscripcionesAprobadas && suscripcionesAprobadas.length > 0) {
        registroMasReciente = suscripcionesAprobadas[0];
      }
      
      if (comprobantesAprobados && comprobantesAprobados.length > 0) {
        const comprobanteReciente = comprobantesAprobados[0];
        if (!registroMasReciente || 
            new Date(comprobanteReciente.actualizado_en) > new Date(registroMasReciente.actualizado_en)) {
          registroMasReciente = comprobanteReciente;
        }
      }

      if (registroMasReciente) {
        console.log('🔍 DEBUG: Plan activo encontrado:', registroMasReciente);
        return registroMasReciente;
      }

      return null;
    } catch (error) {
      console.error('Error obteniendo plan activo:', error);
      return null;
    }
  };

  // Función para cargar datos de la empresa (definida fuera del useEffect)
  const cargarEmpresa = async () => {
    try {
      const supabase = createClient();

      // Debug: Imprimir el ID de la empresa
      console.log('🔍 DEBUG: user.empresa_id:', user?.empresa_id);

      // ✅ Primero verificar si hay solicitudes pendientes
      if (!user?.empresa_id) {
        console.error('❌ ERROR: user.empresa_id es nulo o indefinido');
        return;
      }

      const { data: pendingData, error: pendingError } = await supabase
        .from('comprobantes')
        .select(`
          *,
          planes (*)
        `)
        .eq('empresa_id', user.empresa_id)
        .eq('estado', 'pendiente')
        .order('creado_en', { ascending: false });

      if (!pendingError && pendingData && pendingData.length > 0) {
        setHasPendingChange(true);
        setPendingRequest(pendingData[0]);
        console.log('🔍 DEBUG: Solicitud pendiente encontrada:', pendingData[0]);
      } else {
        setHasPendingChange(false);
        setPendingRequest(null);
      }

      const { data, error } = await supabase
        .from('empresas')
        .select(`
          *,
          planes (*)
        `)
        .eq('id', user.empresa_id)
        .limit(1)
        .single();

      console.log('🔍 DEBUG: Datos crudos de Supabase:', { data, error });

      if (error) {
        console.error('❌ ERROR: Error cargando empresa:', error);
        return;
      }

      if (!data) {
        console.error('❌ ERROR: No se encontraron datos de la empresa');
        return;
      }

      // Mapear los datos para incluir beneficios del plan
      const empresaData = data as any;
      const planData = empresaData.planes || {};

      console.log('🔍 DEBUG: Datos del plan:', planData);
      console.log('🔍 DEBUG: Datos de la empresa:', empresaData);

      // Acceso seguro a los datos del plan
      const planNombre = planData?.nombre || empresaData.plan_nombre || 'Sin plan';
      const planPrecio = planData?.precio || empresaData.plan_precio || 0;

      console.log('🔍 DEBUG: Valores extraídos:', { planNombre, planPrecio });

      setEmpresa({
        ...empresaData,
        plan_nombre: planNombre,
        plan_precio: planPrecio,
        tiene_inventario: planData?.tiene_inventario || false,
        tiene_comisiones: planData?.tiene_comisiones || false,
        tiene_marketing: planData?.tiene_marketing || false,
        soporte_prioritario: planData?.soporte_prioritario || false
      });

      console.log('🔍 DEBUG: Empresa actualizada con beneficios:', {
        plan_nombre: planData.nombre || 'Sin plan',
        plan_precio: planData.precio || 0,
        tiene_inventario: planData.tiene_inventario || false,
        tiene_comisiones: planData.tiene_comisiones || false,
        tiene_marketing: planData.tiene_marketing || false,
        soporte_prioritario: planData.soporte_prioritario || false
      });

    } catch (error) {
      console.error('❌ ERROR: Error en cargarEmpresa:', error);
    }
  };

  useEffect(() => {
    if (user?.id) {
      cargarEmpresa();
    }
  }, [user?.id]);

  // Función para abrir modal de cambio de plan
  const handleChangePlan = () => {
    if (!empresa) return;

    cargarPlanesDisponibles();
    setShowChangePlanModal(true);
    setSelectedNewPlan(null);
  };

  // Función para cargar planes disponibles para cambio
  const cargarPlanesDisponibles = async () => {
    try {
      const supabase = createClient();
      const { data, error } = await supabase
        .from('planes')
        .select('*')
        .neq('id', empresa?.plan_id || '')
        .order('precio', { ascending: true });

      if (error) {
        console.error('Error cargando planes disponibles:', error);
        setPlanesDisponibles([]);
      } else {
        setPlanesDisponibles(data || []);
      }
    } catch (error) {
      console.error('Error en cargarPlanesDisponibles:', error);
      setPlanesDisponibles([]);
    }
  };

  // Función para confirmar cambio de plan
  const confirmChangePlan = async () => {
    if (!empresa || !selectedNewPlan) return;

    // Calcular diferencia de precio
    const precioActual = empresa.plan_precio || 0;
    const precioNuevo = selectedNewPlan.precio || 0;
    const diferencia = precioNuevo - precioActual;

    // Si hay diferencia de precio, mostrar modal de confirmación
    if (diferencia > 0) {
      setShowConfirmModal(true);
    } else {
      // Si no hay diferencia, proceder directamente
      executePlanChange();
    }
  };

  // Función para ejecutar el cambio de plan
  const executePlanChange = async () => {
    if (!empresa || !selectedNewPlan) return;

    try {
      setChangingPlan(true);

      const precioActual = empresa.plan_precio || 0;
      const precioNuevo = selectedNewPlan.precio || 0;

      const supabase = createClient();

      // ✅ Crear registro en comprobantes con estado = 'pendiente'
      // NO actualizar el plan_id en la tabla empresas todavía
      const nuevoComprobante = {
        empresa_id: empresa.id,
        // ✅ La tabla comprobantes no tiene columna plan_id, solo empresa_id
        estado: 'pendiente',  // ✅ Estado pendiente en comprobantes
        fecha_envio: new Date().toISOString(),
        creado_en: new Date().toISOString(),
        actualizado_en: new Date().toISOString(),
        nombre_archivo: `Solicitud cambio plan - ${selectedNewPlan.nombre}`,
        // ✅ url_archivo es obligatoria, usar cadena vacía temporal
        url_archivo: '',  // ✅ Cadena vacía hasta que se suba el archivo
        notas: `Solicitud de cambio de plan de "${empresa.plan_nombre}" a "${selectedNewPlan.nombre}" - Plan ID: ${selectedNewPlan.id}`,
        verificado: false,
        // ✅ tipo_archivo también es obligatoria, usar cadena vacía
        tipo_archivo: '',  // ✅ Cadena vacía para solicitudes pendientes
        tamano_bytes: null
      };

      console.log('🔍 DEBUG: Creando comprobante pendiente:', nuevoComprobante);

      const { error: comprobanteError } = await (supabase
        .from('comprobantes') as any)
        .insert(nuevoComprobante);

      if (comprobanteError) {
        console.error('Error creando comprobante pendiente:', comprobanteError);
        setMessage({ type: 'error', text: 'Error al solicitar cambio de plan. Inténtalo de nuevo.' });
      } else {
        // ✅ NO actualizar el plan de la empresa aquí
        // Solo recargar para mostrar el estado pendiente
        await cargarEmpresa();
        
        setMessage({
          type: 'success',
          text: `Solicitud de cambio al plan "${selectedNewPlan.nombre}" enviada exitosamente. Espera la aprobación del administrador.`
        });

        // ✅ Actualizar estado de solicitud pendiente
        setHasPendingChange(true);
        setPendingRequest({
          ...nuevoComprobante,
          planes: selectedNewPlan
        });
      }

      setShowChangePlanModal(false);
      setShowConfirmModal(false);
      setSelectedNewPlan(null);
    } catch (error) {
      console.error('Error en executePlanChange:', error);
      setMessage({ type: 'error', text: 'Error al solicitar cambio de plan. Inténtalo de nuevo.' });
    } finally {
      setChangingPlan(false);
    }
  };

  const cargarComprobantes = async () => {
    try {
      setLoadingComprobantes(true);

      if (!user?.empresa_id) return;

      const supabase = createClient();

      // ✅ Cargar TODOS los registros de comprobantes (historial completo)
      let todosLosRegistros: any[] = [];

      // Cargar comprobantes (incluyendo solicitudes de cambio de plan)
      try {
        const { data: comprobantesData } = await (supabase
          .from('comprobantes') as any)
          .select(`
            *,
            empresas!inner (
              *,
              planes (*)
            )
          `)
          .eq('empresa_id', user.empresa_id)
          .order('fecha_envio', { ascending: false });

        if (comprobantesData) {
          const comprobantesFormateados = comprobantesData.map((comp: any) => ({
            ...comp,
            tipo_registro: comp.estado === 'pendiente' ? 'solicitud_cambio' : 'comprobante',
            plan_nombre: comp.empresas?.planes?.nombre || comp.empresas?.plan_nombre || 'Desconocido',
            plan_precio: comp.empresas?.planes?.precio || comp.empresas?.plan_precio || 0,
            empresa_nombre: comp.empresas?.nombre || 'Mi Empresa',
            fecha_registro: comp.fecha_envio,
            estado_registro: comp.estado,
            nombre_archivo: comp.nombre_archivo || (comp.estado === 'pendiente' ? `Solicitud cambio plan - ${comp.empresas?.planes?.nombre}` : comp.nombre_archivo)
          }));
          todosLosRegistros.push(...comprobantesFormateados);
        }
      } catch (error) {
        console.error('Error cargando comprobantes:', error);
      }

      // ✅ Ordenar todos los registros por fecha (más reciente primero)
      todosLosRegistros.sort((a, b) => 
        new Date(b.fecha_registro).getTime() - new Date(a.fecha_registro).getTime()
      );

      console.log('🔍 DEBUG: Todos los registros combinados:', todosLosRegistros);

      // Aplicar filtros sobre el conjunto combinado
      let registrosFiltrados = todosLosRegistros;

      if (filtroEstado !== 'todos') {
        registrosFiltrados = registrosFiltrados.filter(reg => 
          reg.estado_registro === filtroEstado
        );
      }

      if (fechaInicio) {
        registrosFiltrados = registrosFiltrados.filter(reg => 
          new Date(reg.fecha_registro) >= new Date(fechaInicio)
        );
      }

      if (fechaFin) {
        registrosFiltrados = registrosFiltrados.filter(reg => 
          new Date(reg.fecha_registro) <= new Date(fechaFin + 'T23:59:59')
        );
      }

      // Paginación
      const from = (currentPage - 1) * itemsPerPage;
      const to = from + itemsPerPage - 1;
      const registrosPaginados = registrosFiltrados.slice(from, to + 1);

      setComprobantes(registrosPaginados);
      setTotalPages(Math.ceil(registrosFiltrados.length / itemsPerPage));
    } catch (error) {
      console.error('Error en cargarComprobantes:', error);
    } finally {
      setLoadingComprobantes(false);
    }
  };

  useEffect(() => {
    if (user?.empresa_id) {
      cargarEmpresa();
    }
  }, [user?.empresa_id]);

  useEffect(() => {
    if (user?.empresa_id) {
      cargarComprobantes();
    }
  }, [user?.empresa_id, currentPage, filtroEstado, fechaInicio, fechaFin]);

  const openComprobanteModal = (comprobante: any) => {
    setSelectedComprobante(comprobante);
    setShowViewModal(true);
  };

  const formatearFecha = (fechaString: string | null) => {
    if (!fechaString) return 'No disponible';

    try {
      const fecha = new Date(fechaString);
      if (isNaN(fecha.getTime())) {
        return 'Fecha inválida';
      }

      const opciones: Intl.DateTimeFormatOptions = {
        day: 'numeric',
        month: 'long',
        year: 'numeric'
      };
      return fecha.toLocaleDateString('es-ES', opciones);
    } catch (error) {
      console.error('Error formateando fecha:', error);
      return 'Fecha inválida';
    }
  };

  const getEstadoSuscripcion = () => {
    if (!empresa || !empresa.fecha_vencimiento) return 'desconocido';

    try {
      const fechaVencimiento = new Date(empresa.fecha_vencimiento);
      if (isNaN(fechaVencimiento.getTime())) {
        return 'desconocido';
      }

      const fechaActual = new Date();
      const diasRestantes = Math.ceil((fechaVencimiento.getTime() - fechaActual.getTime()) / (1000 * 60 * 60 * 24));

      if (diasRestantes < 0) return 'vencido';
      if (diasRestantes <= 7) return 'por-vencer';
      return 'activo';
    } catch (error) {
      console.error('Error calculando estado de suscripción:', error);
      return 'desconocido';
    }
  };

  const getEstadoColor = (estado: string) => {
    switch (estado) {
      case 'activo': return 'text-green-600 bg-green-100';
      case 'por-vencer': return 'text-amber-600 bg-amber-100';
      case 'vencido': return 'text-red-600 bg-red-100';
      default: return 'text-gray-600 bg-gray-100';
    }
  };

  const getEstadoIcon = (estado: string) => {
    switch (estado) {
      case 'activo': return <CheckCircleIcon className="w-5 h-5" />;
      case 'por-vencer': return <ExclamationTriangleIcon className="w-5 h-5" />;
      case 'vencido': return <ClockIcon className="w-5 h-5" />;
      default: return <ClockIcon className="w-5 h-5" />;
    }
  };

  if (loading) {
    return (
      <MainLayout>
        <div className="flex items-center justify-center h-64">
          <div className="text-gray-500">Cargando información de suscripción...</div>
        </div>
      </MainLayout>
    );
  }

  if (!user || !user.empresa_id) {
    return (
      <MainLayout>
        <div className="flex items-center justify-center h-64">
          <div className="text-red-500">No tienes una empresa asociada</div>
        </div>
      </MainLayout>
    );
  }

  const estadoSuscripcion = getEstadoSuscripcion();

  return (
    <MainLayout>
      <div className="w-full space-y-8 px-4 py-6">
        {/* Header */}
        <div>
          <h1 className="text-3xl font-bold text-gray-900">Mi Suscripción</h1>
          <p className="text-gray-600">Gestiona tu plan y estado de pago</p>
        </div>

        {/* Mensajes */}
        {message && (
          <div className={`p-4 rounded-lg ${message.type === 'success' ? 'bg-green-50 text-green-800 border border-green-200' :
              message.type === 'error' ? 'bg-red-50 text-red-800 border border-red-200' :
                'bg-blue-50 text-blue-800 border border-blue-200'
            }`}>
            <div className="flex items-center justify-between">
              <span>{message.text}</span>
              <button
                onClick={() => setMessage(null)}
                className="ml-4 text-gray-500 hover:text-gray-700"
              >
                <XMarkIcon className="w-5 h-5" />
              </button>
            </div>
          </div>
        )}

        {/* Estado de Suscripción */}
        <div className="max-w-4xl mx-auto">
          <Card>
            <CardHeader>
              <CardTitle>Estado de Suscripción</CardTitle>
              <CardDescription>Información actual de tu plan y estado de pago</CardDescription>
            </CardHeader>
            <CardContent>
              {empresa ? (
                <div className="space-y-4">
                  <div className="flex items-center justify-between">
                    <div>
                      <p className="text-sm text-gray-600">Plan Actual</p>
                      <p className="text-lg font-semibold text-gray-900">{empresa.plan_nombre}</p>
                    </div>
                    <div className="text-right">
                      <p className="text-sm text-gray-600">Precio Mensual</p>
                      <p className="text-lg font-semibold text-gray-900">${empresa.plan_precio}</p>
                    </div>
                  </div>

                  {/* Beneficios del Plan */}
                  <PlanBenefits plan={empresa} />

                  {/* ✅ Banner de Solicitud Pendiente */}
                  {hasPendingChange && pendingRequest && (
                    <div className="p-4 bg-amber-50 border border-amber-200 rounded-lg">
                      <div className="flex items-start gap-3">
                        <div className="p-1 bg-amber-100 rounded-full">
                          <ClockIcon className="w-4 h-4 text-amber-600" />
                        </div>
                        <div className="flex-1">
                          <p className="font-medium text-amber-900">
                            Solicitud de Cambio Pendiente
                          </p>
                          <p className="text-sm text-amber-700 mt-1">
                            Tu solicitud para el Plan <span className="font-semibold">{pendingRequest.planes?.nombre}</span> está en revisión.
                          </p>
                          <p className="text-xs text-amber-600 mt-2">
                            Enviada el {new Date(pendingRequest.fecha_envio || pendingRequest.creado_en).toLocaleDateString('es-ES', {
                              day: 'numeric',
                              month: 'long',
                              year: 'numeric',
                              hour: '2-digit',
                              minute: '2-digit'
                            })}
                          </p>
                        </div>
                      </div>
                    </div>
                  )}

                  <div className="flex items-center justify-between">
                    <div>
                      <p className="text-sm text-gray-600">Estado</p>
                      <div className="flex items-center gap-2 mt-1">
                        {getEstadoIcon(estadoSuscripcion)}
                        <span className={`px-2 py-1 rounded-full text-xs font-medium ${getEstadoColor(estadoSuscripcion)}`}>
                          {estadoSuscripcion === 'activo' ? 'Activa' :
                            estadoSuscripcion === 'por-vencer' ? 'Por Vencer' :
                              estadoSuscripcion === 'vencido' ? 'Vencida' : 'Desconocido'}
                        </span>
                      </div>
                    </div>
                    <div className="text-right">
                      <p className="text-sm text-gray-600">Próximo Vencimiento</p>
                      <p className="text-lg font-semibold text-gray-900">
                        {empresa.fecha_vencimiento ? formatearFecha(empresa.fecha_vencimiento) : 'No disponible'}
                      </p>
                    </div>
                  </div>

                  {/* Botón de Cambiar Plan */}
                  <div className="pt-4 border-t border-gray-200">
                    {hasPendingChange ? (
                      <div className="p-4 bg-amber-50 border border-amber-200 rounded-lg">
                        <div className="flex items-center gap-2">
                          <ExclamationTriangleIcon className="w-5 h-5 text-amber-600" />
                          <div>
                            <p className="text-sm font-medium text-amber-800">Tienes un cambio de plan pendiente de aprobación</p>
                            <p className="text-sm text-amber-600">El administrador está revisando tu solicitud</p>
                          </div>
                        </div>
                      </div>
                    ) : (
                      <Button
                        variant="primary"
                        onClick={handleChangePlan}
                        className="w-full flex items-center justify-center gap-2"
                      >
                        <ArrowUpTrayIcon className="w-4 h-4" />
                        Cambiar Plan
                      </Button>
                    )}
                  </div>

                  {estadoSuscripcion === 'vencido' && (
                    <div className="p-4 bg-red-50 border border-red-200 rounded-lg">
                      <div className="flex items-center gap-2">
                        <ExclamationTriangleIcon className="w-5 h-5 text-red-600" />
                        <div>
                          <p className="text-sm font-medium text-red-800">Tu suscripción está vencida</p>
                          <p className="text-sm text-red-600">Por favor, sube un comprobante de pago para reactivar tu cuenta.</p>
                        </div>
                      </div>
                    </div>
                  )}

                  {estadoSuscripcion === 'por-vencer' && (
                    <div className="p-4 bg-amber-50 border border-amber-200 rounded-lg">
                      <div className="flex items-center gap-2">
                        <ExclamationTriangleIcon className="w-5 h-5 text-amber-600" />
                        <div>
                          <p className="text-sm font-medium text-amber-800">Tu suscripción está por vencer</p>
                          <p className="text-sm text-amber-600">Renueva antes de la fecha de vencimiento para evitar interrupciones.</p>
                        </div>
                      </div>
                    </div>
                  )}
                </div>
              ) : (
                <div className="text-center py-8">
                  <p className="text-gray-500">No se encontró información de suscripción</p>
                </div>
              )}
            </CardContent>
          </Card>
        </div>

        {/* Comprobantes Enviados */}
        <div className="max-w-[1200px] mx-auto">
          <Card>
            <CardHeader>
              <div>
                <CardTitle>Historial de Envíos</CardTitle>
                <CardDescription>Historial de comprobantes enviados</CardDescription>
              </div>
            </CardHeader>
            <CardContent>
              {/* Filtros */}
              <div className="mb-4 p-4 bg-gray-50 rounded-lg">
                <div className="grid grid-cols-1 md:grid-cols-4 gap-4">
                  <div>
                    <label className="block text-sm font-medium text-gray-700 mb-1">Estado</label>
                    <select
                      className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                      value={filtroEstado}
                      onChange={(e) => {
                        setFiltroEstado(e.target.value);
                        setCurrentPage(1);
                      }}
                    >
                      <option value="todos">Todos</option>
                      <option value="pendiente">Pendiente</option>
                      <option value="aprobado">Aprobado</option>
                      <option value="rechazado">Rechazado</option>
                    </select>
                  </div>
                  <div>
                    <label className="block text-sm font-medium text-gray-700 mb-1">Fecha Inicio</label>
                    <input
                      type="date"
                      className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                      value={fechaInicio}
                      onChange={(e) => {
                        setFechaInicio(e.target.value);
                        setCurrentPage(1);
                      }}
                    />
                  </div>
                  <div>
                    <label className="block text-sm font-medium text-gray-700 mb-1">Fecha Fin</label>
                    <input
                      type="date"
                      className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                      value={fechaFin}
                      onChange={(e) => {
                        setFechaFin(e.target.value);
                        setCurrentPage(1);
                      }}
                    />
                  </div>
                  <div className="flex items-end">
                    <Button
                      variant="outline"
                      onClick={() => {
                        setFiltroEstado('todos');
                        setFechaInicio('');
                        setFechaFin('');
                        setCurrentPage(1);
                      }}
                      className="w-full"
                    >
                      Limpiar Filtros
                    </Button>
                  </div>
                </div>
              </div>

              {/* Tabla de Historial */}
              {comprobantes && comprobantes.length > 0 ? (
                <>
                  <div className="overflow-x-auto">
                    <table className="min-w-full divide-y divide-gray-200">
                      <thead className="bg-gray-50">
                        <tr>
                          <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                            Fecha de Envío
                          </th>
                          <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                            Archivo
                          </th>
                          <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                            Estado
                          </th>
                          <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                            Nota de Admin
                          </th>
                          <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                            Acciones
                          </th>
                        </tr>
                      </thead>
                      <tbody className="bg-white divide-y divide-gray-200">
                        {comprobantes.map((comprobante) => (
                          <tr key={comprobante.id} className={comprobante.estado === 'rechazado' ? 'bg-red-50' : ''}>
                            <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                              {formatearFecha(comprobante.fecha_envio || null)}
                            </td>
                            <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                              {comprobante.nombre_archivo}
                            </td>
                            <td className="px-6 py-4 whitespace-nowrap">
                              {comprobante.estado === 'aprobado' ? (
                                <span className="flex items-center gap-1 px-2 py-1 bg-green-100 text-green-800 rounded-full text-xs font-medium">
                                  <CheckCircleIcon className="w-3 h-3" />
                                  Aprobado
                                </span>
                              ) : comprobante.estado === 'rechazado' ? (
                                <span className="flex items-center gap-1 px-2 py-1 bg-red-100 text-red-800 rounded-full text-xs font-medium">
                                  <XCircleIcon className="w-3 h-3" />
                                  Rechazado
                                </span>
                              ) : (
                                <span className="flex items-center gap-1 px-2 py-1 bg-amber-100 text-amber-800 rounded-full text-xs font-medium">
                                  <ClockIcon className="w-3 h-3" />
                                  Pendiente
                                </span>
                              )}
                            </td>
                            <td className="px-6 py-4 text-sm text-gray-900">
                              {comprobante.notas ? (
                                <div className="max-w-xs">
                                  <span className="text-red-600 font-medium">{comprobante.notas}</span>
                                  {comprobante.estado === 'aprobado' && (
                                    <div className="text-xs text-green-600 mt-1">
                                      Cuenta activada: {formatearFecha(comprobante.actualizado_en || null)}
                                    </div>
                                  )}
                                </div>
                              ) : (
                                <span className="text-gray-400">-</span>
                              )}
                            </td>
                            <td className="px-6 py-4 whitespace-nowrap text-sm font-medium">
                              <Button
                                variant="outline"
                                size="sm"
                                onClick={() => openComprobanteModal(comprobante)}
                              >
                                <EyeIcon className="w-4 h-4 mr-1" />
                                Ver
                              </Button>
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>

                  {/* Paginación */}
                  {totalPages > 1 && (
                    <div className="flex items-center justify-between px-4 py-3 bg-white border-t border-gray-200 sm:px-6">
                      <div className="hidden sm:flex sm:flex-1 sm:items-center sm:justify-between">
                        <div>
                          <p className="text-sm text-gray-700">
                            Página <span className="font-medium">{currentPage}</span> de{' '}
                            <span className="font-medium">{totalPages}</span>
                          </p>
                        </div>
                        <div>
                          <nav className="relative z-0 inline-flex rounded-md shadow-sm -space-x-px">
                            <Button
                              variant="outline"
                              onClick={() => setCurrentPage(prev => Math.max(prev - 1, 1))}
                              disabled={currentPage === 1}
                              className="rounded-l-md"
                            >
                              Anterior
                            </Button>
                            <Button
                              variant="outline"
                              onClick={() => setCurrentPage(prev => Math.min(prev + 1, totalPages))}
                              disabled={currentPage === totalPages}
                              className="rounded-r-md"
                            >
                              Siguiente
                            </Button>
                          </nav>
                        </div>
                      </div>
                    </div>
                  )}
                </>
              ) : (
                <div className="text-center py-8">
                  <DocumentTextIcon className="w-12 h-12 text-gray-400 mx-auto mb-2" />
                  <p className="text-gray-500">
                    {loadingComprobantes ? 'Cargando...' : 'No hay comprobantes enviados'}
                  </p>
                </div>
              )}
            </CardContent>
          </Card>
</div>
          {/* Modal de Vista de Comprobante */}
          {showViewModal && selectedComprobante && (
            <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
              <Card className="w-full max-w-4xl max-h-[90vh] flex flex-col">
                <CardContent className="p-6 flex-1 flex flex-col">
                  <div className="flex justify-between items-start mb-4">
                    <div>
                      <h3 className="text-lg font-semibold">Vista del Comprobante</h3>
                      <p className="text-sm text-gray-600 mt-1">{selectedComprobante.nombre_archivo}</p>
                    </div>
                    <Button
                      variant="ghost"
                      size="sm"
                      onClick={() => {
                        setShowViewModal(false);
                        setSelectedComprobante(null);
                      }}
                    >
                      <XMarkIcon className="w-5 h-5" />
                    </Button>
                  </div>

                  <div className="flex-1 overflow-y-auto">
                    {selectedComprobante.tipo_archivo.startsWith('image/') ? (
                      <img
                        src={selectedComprobante.url_archivo}
                        alt={selectedComprobante.nombre_archivo}
                        className="max-w-full h-auto mx-auto"
                      />
                    ) : (
                      <div className="text-center py-8">
                        <DocumentTextIcon className="w-16 h-16 text-gray-400 mx-auto mb-4" />
                        <p className="text-gray-600 mb-4">
                          Este es un archivo PDF. Haz clic para abrirlo en una nueva pestaña.
                        </p>
                        <a
                          href={selectedComprobante.url_archivo}
                          target="_blank"
                          rel="noopener noreferrer"
                          className="inline-flex items-center px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700"
                        >
                          Abrir PDF
                        </a>
                      </div>
                    )}
                  </div>

                  <div className="flex justify-end gap-2 mt-4 pt-4 border-t">
                    <Button
                      variant="outline"
                      onClick={() => {
                        setShowViewModal(false);
                        setSelectedComprobante(null);
                      }}
                    >
                      Cerrar
                    </Button>
                  </div>
                </CardContent>
              </Card>
            </div>
          )}
        </div>

        {/* Modal de Cambio de Plan - One-Step Checkout */}
        <Dialog open={showChangePlanModal} onOpenChange={setShowChangePlanModal}>
          <DialogContent className="max-w-2xl">
            <DialogHeader>
              <DialogTitle className="text-xl font-bold text-gray-900">
                Cambiar Plan
              </DialogTitle>
              <DialogDescription className="text-gray-600">
                Selecciona tu nuevo plan y sube el comprobante de pago
              </DialogDescription>
            </DialogHeader>

            {!selectedNewPlan ? (
              // Fase 1: Selección de Plan
              <div className="space-y-4">
                <div className="grid gap-4">
                  {planesDisponibles.map((plan: any) => (
                    <div
                      key={plan.id}
                      className={`border rounded-lg p-4 cursor-pointer transition-all ${
                        selectedNewPlan?.id === plan.id
                          ? 'border-blue-500 bg-blue-50'
                          : 'border-gray-200 hover:border-gray-300'
                      }`}
                      onClick={() => setSelectedNewPlan(plan)}
                    >
                      <div className="flex justify-between items-start">
                        <div>
                          <h3 className="font-semibold text-gray-900">{plan.nombre}</h3>
                          <p className="text-sm text-gray-600 mt-1">{plan.descripcion}</p>
                        </div>
                        <div className="text-right">
                          <p className="text-2xl font-bold text-gray-900">${plan.precio}</p>
                          <p className="text-sm text-gray-500">/mes</p>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            ) : (
              // Fase 2: Resumen y Confirmación
              <div className="space-y-6">
                {/* Plan Seleccionado */}
                <div className="bg-gradient-to-r from-blue-50 to-indigo-50 border border-blue-200 rounded-lg p-6">
                  <div className="flex items-center justify-between mb-4">
                    <div className="flex items-center gap-3">
                      <div className="w-12 h-12 bg-blue-600 rounded-lg flex items-center justify-center">
                        <span className="text-white font-bold text-lg">
                          {selectedNewPlan.nombre.charAt(0)}
                        </span>
                      </div>
                      <div>
                        <h4 className="font-bold text-lg text-gray-900">Plan Seleccionado</h4>
                        <p className="text-sm text-gray-600">{selectedNewPlan.descripcion}</p>
                      </div>
                    </div>
                    <button
                      onClick={() => setSelectedNewPlan(null)}
                      className="text-sm text-blue-600 hover:text-blue-700 font-medium flex items-center gap-1"
                    >
                      <ArrowUpTrayIcon className="w-4 h-4" />
                      Cambiar plan
                    </button>
                  </div>
                </div>

                {/* Detalles de Pago */}
                <div className="bg-white border border-gray-200 rounded-lg shadow-sm overflow-hidden">
                  <div className="bg-gradient-to-r from-green-500 to-emerald-600 text-white p-4">
                    <h4 className="font-semibold text-lg flex items-center gap-2">
                      <CurrencyDollarIcon className="w-5 h-5" />
                      Detalles de Pago
                    </h4>
                  </div>
                  <div className="p-6 space-y-4">
                    <div className="flex justify-between items-center py-3 border-b border-gray-100">
                      <span className="text-gray-600 font-medium">Precio del plan:</span>
                      <span className="text-2xl font-bold text-gray-900">${selectedNewPlan.precio}</span>
                    </div>
                    <div className="flex justify-between items-center py-3 border-b border-gray-100">
                      <span className="text-gray-600 font-medium">Frecuencia:</span>
                      <span className="text-lg font-semibold text-gray-900">Mensual</span>
                    </div>
                    <div className="flex justify-between items-center py-3">
                      <span className="text-gray-600 font-medium">Método de pago:</span>
                      <span className="text-lg font-semibold text-gray-900">Transferencia Bancaria</span>
                    </div>
                    <div className="bg-yellow-50 border border-yellow-200 rounded-lg p-4 mt-4">
                      <div className="flex items-start gap-2">
                        <ExclamationTriangleIcon className="w-5 h-5 text-yellow-600 mt-0.5" />
                        <div>
                          <p className="text-sm font-medium text-yellow-800">Importante:</p>
                          <p className="text-sm text-yellow-700 mt-1">
                            Realiza la transferencia y luego sube tu comprobante en la sección "Historial de Pagos" para activar el nuevo plan.
                          </p>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                {/* Datos Bancarios */}
                <div className="bg-white border border-gray-200 rounded-lg shadow-sm overflow-hidden">
                  <div className="bg-gradient-to-r from-purple-500 to-indigo-600 text-white p-4">
                    <h4 className="font-semibold text-lg flex items-center gap-2">
                      <DocumentTextIcon className="w-5 h-5" />
                      Datos Bancarios
                    </h4>
                  </div>
                  <div className="p-6">
                    <div className="bg-gray-50 rounded-lg p-4 mb-4">
                      <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                          <p className="text-sm text-gray-500 font-medium">Banco</p>
                          <p className="text-lg font-semibold text-gray-900">Banco Nacional</p>
                        </div>
                        <div>
                          <p className="text-sm text-gray-500 font-medium">Tipo de Cuenta</p>
                          <p className="text-lg font-semibold text-gray-900">Cuenta Corriente</p>
                        </div>
                      </div>
                    </div>
                    <div className="bg-gray-50 rounded-lg p-4">
                      <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                          <p className="text-sm text-gray-500 font-medium">Número de Cuenta</p>
                          <p className="text-lg font-semibold text-gray-900 font-mono">1234-5678-9012</p>
                        </div>
                        <div>
                          <p className="text-sm text-gray-500 font-medium">Titular</p>
                          <p className="text-lg font-semibold text-gray-900">Mi Empresa S.A.</p>
                        </div>
                      </div>
                    </div>
                    <div className="bg-blue-50 border border-blue-200 rounded-lg p-4">
                      <div className="flex items-center gap-2">
                        <div className="w-8 h-8 bg-green-500 rounded-full flex items-center justify-center">
                          <span className="text-white text-sm font-bold">!</span>
                        </div>
                        <div>
                          <p className="text-sm font-medium text-blue-800">Soporte WhatsApp</p>
                          <p className="text-lg font-semibold text-blue-900">+593 987 654 321</p>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                {/* Instrucciones */}
                <div className="bg-gradient-to-r from-amber-50 to-orange-50 border border-amber-200 rounded-lg p-6">
                  <div className="flex items-start gap-3">
                    <div className="w-8 h-8 bg-amber-500 rounded-full flex items-center justify-center flex-shrink-0">
                      <span className="text-white text-sm font-bold">i</span>
                    </div>
                    <div>
                      <h4 className="font-semibold text-amber-900 mb-2">Instrucciones de Pago</h4>
                      <ol className="text-sm text-amber-800 space-y-2 list-decimal list-inside">
                        <li>Realiza la transferencia por <span className="font-bold text-amber-900">${selectedNewPlan.precio}</span></li>
                        <li>Guarda el comprobante de la transferencia</li>
                        <li>Ve a "Historial de Pagos" y sube el comprobante</li>
                        <li>Espera la aprobación del administrador</li>
                        <li>Tu nuevo plan se activará automáticamente</li>
                      </ol>
              </div>
                    </div>
                  </div>
                </div>
              </div>
            )}

            <DialogFooter>
              <Button variant="outline" onClick={() => setShowConfirmModal(false)}>
                Cancelar
              </Button>
              <Button
                variant="primary"
                onClick={executePlanChange}
                disabled={changingPlan}
                className="bg-blue-600 hover:bg-blue-700"
              >
                {changingPlan ? (
                  <>
                    <div className="animate-spin rounded-full h-4 w-4 border-b-2 border-white mr-2"></div>
                    Procesando...
                  </>
                ) : (
                  <>
                    <CheckCircleIcon className="w-4 h-4 mr-2" />
                    Confirmar Cambio
                  </>
                )}
              </Button>
                  </div>

                  {/* Información importante */}
                  <div className="bg-amber-50 border border-amber-200 rounded-lg p-4">
                    <div className="flex items-start gap-3">
                      <ExclamationTriangleIcon className="w-5 h-5 text-amber-600 mt-0.5 flex-shrink-0" />
                      <div>
                        <h4 className="font-medium text-amber-900 mb-1">Información Importante</h4>
                        <p className="text-sm text-amber-800">
                          Al confirmar, se generará automáticamente un comprobante de pago pendiente por la diferencia.
                          Podrás subir el comprobante desde la sección "Historial de Envíos".
                        </p>
                      </div>
                    </div>
                  </div>

                  {/* Nuevos beneficios */}
                  <div className="bg-green-50 border border-green-200 rounded-lg p-4">
                    <h4 className="font-medium text-green-900 mb-2">Nuevos Beneficios Incluidos</h4>
                    <div className="grid grid-cols-2 gap-2">
                      {selectedNewPlan.tiene_inventario && (
                        <div className="flex items-center gap-2 text-sm text-green-800">
                          <CheckCircleIcon className="w-4 h-4" />
                          <span>Inventario</span>
                        </div>
                      )}
                      {selectedNewPlan.tiene_comisiones && (
                        <div className="flex items-center gap-2 text-sm text-green-800">
                          <CheckCircleIcon className="w-4 h-4" />
                          <span>Comisiones</span>
                        </div>
                      )}
                      {selectedNewPlan.tiene_marketing && (
                        <div className="flex items-center gap-2 text-sm text-green-800">
                          <CheckCircleIcon className="w-4 h-4" />
                          <span>Marketing</span>
                        </div>
                      )}
                      {selectedNewPlan.soporte_prioritario && (
                        <div className="flex items-center gap-2 text-sm text-green-800">
                          <CheckCircleIcon className="w-4 h-4" />
                          <span>Soporte Prioritario</span>
                        </div>
                      )}
                    </div>
                  </div>
                </div>
              )}
            </div>

            <DialogFooter>
              <Button variant="outline" onClick={() => setShowConfirmModal(false)}>
                Cancelar
              </Button>
              <Button
                variant="primary"
                onClick={executePlanChange}
                disabled={changingPlan}
                className="bg-blue-600 hover:bg-blue-700"
              >
                {changingPlan ? (
                  <>
                    <div className="animate-spin rounded-full h-4 w-4 border-b-2 border-white mr-2"></div>
                    Procesando...
                  </>
                ) : (
                  <>
                    <CheckCircleIcon className="w-4 h-4 mr-2" />
                    Confirmar Cambio
                  </>
                )}
              </Button>
            </DialogFooter>
          </DialogContent>
        </Dialog>
      </MainLayout>
  );
}
